{
  "key_path": "DeveloperToolsDescriptionStandalone",
  "content": "Integrate, extend, and automate {{organizationName}} {{editorsName}} and {{productName}} using developer tools — from Embed SDK and webhooks to OAuth apps and API keys. Choose a tool below to get started.",
  "content_en_sha1_hash": "037f695e4460c382118dfd6d7b5386e6424fd8a8",
