{
  "key_path": "FolderUploadNotSupportedInPrivateRoom",
  "content": "Folders cannot be uploaded to a private room and were skipped.",
  "content_en_sha1_hash": "3d2729d9c6420dc4d6b8769653d69a1931a408ff",
  "created_at": "2026-10-20T09:54:14.766Z",
  "updated_at": "2026-10-21T08:31:09.621Z",
  "comment": {
    "text": "Warning toast shown when folders are dropped or pasted into an open private (end-to-end encrypted) room or onto one of its folders: the folders are skipped, while loose files in the same drop are still uploaded. Drops onto a private room from outside it get a different message.",
    "is_auto": true,
    "updated_at": "2026-10-21T08:31:09.621Z",
    "model": "claude-opus-5-5"
  },
  "usage": [
    {
      "file_path": "/packages/client/src/store/filesActionsStore/selection.helpers.ts",
      "line_number": 225,
      "context": "const isFolderEntry = (f: TUploadTreeFile) =>\n !!f.isEmptyDirectory ||\n (f.path ?? \"\").split(\"/\").filter((name) => name !== \"\").length > 1;\n const fileEntries = withoutHiddenFiles.filter((f) => !isFolderEntry(f));\n if (fileEntries.length !== withoutHiddenFiles.length) {\n toastr.warning(t(\"Common:FolderUploadNotSupportedInPrivateRoom\"));\n withoutHiddenFiles = fileEntries;\n }\n }\n \n const operationId = uniqueid(\"operation_\");",
      "module": "/packages/client"
    }
  ],
