  "key_path": "AttachFilesAnalyzingBusy",
  "content": "Wait for the current answer to finish before analyzing another form.",
  "content_en_sha1_hash": "1f700931bbe327a784330b0b5fee50a72be55691",
  "created_at": "2026-09-25T10:58:06.992Z",
  "updated_at": "2026-09-25T11:00:03.689Z",
  "comment": {
    "text": "An info toast message appearing when a user attempts to initiate a new file analysis while the AI agent is still processing a response for a previous form.",
    "is_auto": true,
    "updated_at": "2026-09-25T11:00:03.689Z",
    "model": "gemma4:26b"
  },
  "usage": [
    {
      "file_path": "/libs/ui-kit/ai-agent/providers/files/notices.ts",
      "line_number": 94,
      "context": "// Not a cap at all, but the same refusal from the user's side: the chat is\n // mid-answer about the form it is analyzing, and picking a new subject now\n // would re-point it under the reply still arriving.\n if (cap.reason === \"busy\") {\n toastr.info(\n t(\"Common:AttachFilesAnalyzingBusy\", {\n defaultValue:\n \"Wait for the current answer to finish before analyzing another form.\",\n }),\n );\n return;",
      "module": "/libs/ui-kit"
    }
  ],
