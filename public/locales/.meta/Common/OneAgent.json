      "line_number": 48,
      "context": "* it: \"1 agent\", \"4 agents\", or a dash when none does or the room gives no\n * number.\n */\n export const getUsedByText = (t: TTranslation, count?: number | null) => {\n if (!count || count < 0) return USED_BY_NONE;\n if (count === 1) return t(\"Common:OneAgent\");\n return t(\"Common:AgentsNumber\", { agentsCount: count });\n };",
      "module": "/packages/client"
    }
