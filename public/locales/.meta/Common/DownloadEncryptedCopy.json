      "context": "newOptions = [\n ...newOptions\n .filter((option) => option.key !== \"download\")\n .map((option) =>\n option.key === \"download-encrypted\"\n ? { ...option, label: t(\"Common:DownloadEncryptedCopy\") }\n : option,\n ),\n originalDownloadOption,\n ];",
