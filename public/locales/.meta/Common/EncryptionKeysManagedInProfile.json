  "comment": {
    "text": "Info toast in the embedded private-rooms view, shown instead of opening the keys page when the user's profile cannot be opened from the host site (from the forgot-passphrase link or the device-setup hint). {{productName}} is the product name and stays untranslated; Keys management is the name of the profile tab and should match its translation (Common:KeysManagement).",
    "is_auto": true,
    "updated_at": "2026-10-26T08:16:30.560Z",
    "model": "claude-opus-5-5"
  },
