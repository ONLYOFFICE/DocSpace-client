  "key_path": "AiRoomsTurnedOff",
  "content": "AI has been turned off. AI rooms are unavailable until the Full admin turns it on again.",
  "content_en_sha1_hash": "2cccc4a429759ed6ea7b81e7823c1ba558c4f753",
