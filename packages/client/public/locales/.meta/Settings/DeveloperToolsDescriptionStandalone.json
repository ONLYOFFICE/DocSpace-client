  "comment": {
    "text": "Subtitle under the Developer Tools heading on the Developer Tools overview page, shown on portals where Docs Connect is not available; it introduces the tool cards below. {{organizationName}} {{editorsName}} together form the editors' brand name and {{productName}} is the product name, all left untranslated; Embed SDK, OAuth and API keys name the tool cards on the page.",
    "is_auto": true,
    "updated_at": "2026-10-20T09:58:48.413Z",
    "model": "claude-opus-5-5"
  },
  "usage": [
    {
      "file_path": "/packages/client/src/pages/PortalSettings/categories/developer-tools/Main/index.tsx",
      "line_number": 107,
      "context": "? t(\"Settings:DeveloperToolsDescription\", {\n organizationName: getBrandName(\"OrganizationName\"),\n editorsName: getBrandName(\"ProductEditorsName\"),\n productName: getBrandName(\"ProductName\"),\n })\n : t(\"Settings:DeveloperToolsDescriptionStandalone\", {\n organizationName: getBrandName(\"OrganizationName\"),\n editorsName: getBrandName(\"ProductEditorsName\"),\n productName: getBrandName(\"ProductName\"),\n })}\n </Text>",
      "module": "/packages/client"
    }
