  "comment": {
    "text": "Error text on the row of a failed upload in the uploads panel of a private (end-to-end encrypted) room, in the web client and the SDK. Shown when the file reached the server but its encryption key could not be saved for the uploader, so the file was deleted again; the row offers a retry. Two short sentences: a statement that nothing was saved, then an imperative asking to upload the file again.",
    "is_auto": true,
    "updated_at": "2026-11-11T12:36:16.847Z",
    "model": "claude-fable-5-2"
  },
  "usage": [
    {
      "file_path": "/packages/shared/services/private-room/encrypted-upload-orchestrator.ts",
      "line_number": 364,
      "context": "export const getEncryptedUploadErrorMessage = (t: TFunction, error: unknown) => {\n if (error instanceof EncryptedReimportError) {\n return t(\"Common:EncryptionReimportFailed\");\n }\n if (error instanceof EncryptedUploadNotKeptError) {\n return t(\"Common:EncryptionUploadNotKept\");\n }\n if (error instanceof EncryptedWrapError) {\n return t(\"Common:EncryptionUploadWrapFailed\");\n }\n if (error instanceof CryptoError) return getEncryptionErrorMessage(t, error);",
      "module": "/packages/shared"
    }
