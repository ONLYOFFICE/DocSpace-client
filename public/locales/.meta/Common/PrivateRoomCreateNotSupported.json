{
  "key_path": "PrivateRoomCreateNotSupported",
  "content": "Files with the .{{extension}} extension cannot be created in a private room.",
  "content_en_sha1_hash": "77127c8ab5451aaaf926a69292202f02c86ca2b6",
  "created_at": "2026-10-23T12:00:17.555Z",
  "updated_at": "2026-10-23T12:02:01.690Z",
  "comment": {
    "text": "Error toast shown when a file of a type that cannot be encrypted is about to be created inside a private room (only documents, spreadsheets and presentations can be); {{extension}} is the file extension without the dot, such as pdf, so keep the dot written before it.",
    "is_auto": true,
    "updated_at": "2026-10-23T12:02:01.690Z",
    "model": "claude-opus-5-5"
  },
  "usage": [
    {
      "file_path": "/packages/shared/services/encryption/error-i18n.ts",
      "line_number": 59,
      "context": "t: TFunction,\n error: unknown,\n ): string {\n if (error instanceof EncryptedCreateError) {\n return error.code === \"UNSUPPORTED_EXTENSION\"\n ? t(\"Common:PrivateRoomCreateNotSupported\", {\n extension: error.extension,\n })\n : t(\"Common:EncryptionKeysNotConfigured\");\n }\n if (error instanceof WebCryptoUnavailableError) {",
      "module": "/packages/shared"
    }
  ],
