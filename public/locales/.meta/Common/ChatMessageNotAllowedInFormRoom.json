  "comment": {
    "text": "Warning toast. Appears when a user tries to save an AI chat message into a Form Filling room in the save-file picker; that room type only accepts PDF forms.",
    "is_auto": false,
    "updated_at": "2026-09-08T09:53:44.547Z",
    "model": null
  },
  "usage": [
    {
      "file_path": "/libs/ui-kit/ai-agent/providers/files/save-dialog.tsx",
      "line_number": 255,
      "context": "// own warning toast instead (Bug 83615). Kept for every format: such a\n // space only accepts PDF forms, and an exported chat is never one —\n // not even when it is exported as a .pdf.\n formProps={{\n isRoomFormAccessible: false,\n message: t(\"Common:ChatMessageNotAllowedInFormRoom\", {\n defaultValue:\n \"The chat message cannot be saved to the Form Filling space since this space type can only contain PDF forms.\",\n }),\n }}\n isThirdParty={false}",
      "module": "/libs/ui-kit"
    }
