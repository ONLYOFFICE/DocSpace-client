  "key_path": "EncryptionKeysManagedInProfile",
  "content": "Encryption keys are managed in your {{productName}} profile, on the Keys management tab.",
  "content_en_sha1_hash": "2bd844eb9bd974bf73df7bdb41fcc85671e238d0",
