{
  "name": "translations-tests",
  "version": "1.0.0",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "test": "vitest run",
    "test:lefthook": "cross-env SKIP_BASE_LANGUAGES_TEST=true SKIP_ALL_LANGUAGES_TEST=true vitest run",
    "test:only-base-languages": "vitest run locales.test.js --testNamePattern=\"NotTranslatedOnBaseLanguages\"",
    "test:only-all-languages": "vitest run locales.test.js --testNamePattern=\"NotTranslatedOnAllLanguages\"",
    "test:only-missing-keys": "vitest run locales.test.js --testNamePattern=\"NotTranslatedOnAllLanguages|MissingLocaleFilesTest\"",
    "test:skip-base-languages": "cross-env SKIP_BASE_LANGUAGES_TEST=true vitest run locales.test.js",
    "test:locales": "vitest run locales.test.js",
    "test:images": "vitest run images.test.js",
    "test:colors": "vitest run colors.test.js",
    "test:ascii": "vitest run ascii.test.js",
    "test:license": "vitest run license.test.js",
    "test:dependencies": "vitest run dependencies.test.js",
    "open-report": "open-cli reports/tests-report.html"
  },
  "devDependencies": {
    "@vitest/ui": "4.1.8",
    "cross-env": "^10.1.0",
    "jsdom": "^28.1.0",
    "vitest": "4.1.8",
    "open-cli": "^9.0.0"
  },
  "overrides": {
    "undici": "^7.29.0",
    "postcss": "^8.5.23"
  }
}