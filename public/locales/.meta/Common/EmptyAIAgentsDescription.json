      "context": ") => {\n return isUser(access)\n ? t(\"Common:EmptyAIAgentsAIEnabledUserDescription\", {\n aiAgents: t(\"Common:AIAgents\"),\n })\n : t(\"Common:EmptyAIAgentsDescription\", {\n mcpServer: t(\"Common:MCPServer\"),\n });\n };\n \n export const getRootDescription = (",
