  "comment": {
    "text": "Second line of a tooltip shown to a regular user who hovers an app (Rooms, Forms, AI Agents) that the administrator has switched off on a self-hosted portal, on the Dashboard app card and on the app item in the left sidebar. Appears under the bold title \"This app is disabled\". \"it\" refers to the app; \"enable\" means switching the app back on. Use the same term for \"workspace\" as elsewhere in the product.",
    "is_auto": false,
    "updated_at": "2026-10-14T14:29:14.556Z"
  },
