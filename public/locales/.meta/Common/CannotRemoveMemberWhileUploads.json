  "comment": {
    "text": "Warning toast message appearing when attempting to remove a member from a private room during active uploads. The {{count}} variable represents the number of ongoing uploads.",
    "is_auto": true,
    "updated_at": "2026-05-24T18:30:00.510Z",
    "model": "gemma4:26b"
  },
  "usage": [
    {
      "file_path": "/packages/client/src/pages/Home/InfoPanel/Body/views/Members/sub-components/User.tsx",
      "line_number": 205,
      "context": "const isPrivateRoom = room.private;\n if (isRemoval && isPrivateRoom) {\n const activeUploads = getActiveUploadCountForRoom?.(room.id) ?? 0;\n if (activeUploads > 0) {\n toastr.warning(\n t(\"Common:CannotRemoveMemberWhileUploads\", {\n count: activeUploads,\n }),\n );\n return;\n }",
      "module": "/packages/client"
    }
  ],
