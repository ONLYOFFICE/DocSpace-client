# All values are optional — the defaults target the local dev stack.

# Portal to test against. Must live on the "localhost" host for the
# post-consent cookie wipe to work (cookies ignore ports).
#PORTAL_URL=http://localhost:8092

# Stand port; the stand origin is always http://localhost:<PORT>.
#PORT=8888

# Prefill for the portal sign-in form (email only, never the password).
#DEFAULT_LOGIN=admin@example.com
