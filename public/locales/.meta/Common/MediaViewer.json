  "comment": {
    "text": "Name of the Media viewer embed preset in Developer Tools > Embed SDK: title of its card in the preset list and of the page header when the preset is open. A noun phrase for a tool that shows images, video and audio from a room or folder; keep it short, like the sibling presets Viewer and Uploader.",
    "is_auto": true,
    "updated_at": "2026-11-20T13:26:28.013Z",
    "model": "claude-opus-5-5"
  },
  "usage": [
    {
      "file_path": "/packages/client/src/pages/PortalSettings/categories/developer-tools/DeveloperToolsHeader.tsx",
      "line_number": 68,
      "context": "case \"custom\":\n return t(\"Common:Custom\");\n case \"uploader\":\n return t(\"Common:Uploader\");\n case \"media-viewer\":\n return t(\"Common:MediaViewer\");\n default:\n return null;\n }\n };",
      "module": "/packages/client"
    },
    {
