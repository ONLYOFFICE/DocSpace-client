  "comment": {
    "text": "Warning toast after uploading to an end-to-end encrypted private room, shown when a file was stored but its key could not be shared with the other room members, so they cannot open it yet. {{names}} is a comma-separated list of the uploaded file names, one or several; Members panel is the room's member list in the info panel, where a pending member can be retried.",
    "is_auto": true,
    "updated_at": "2026-11-02T09:22:12.398Z",
    "model": "claude-opus-5-5"
  },
