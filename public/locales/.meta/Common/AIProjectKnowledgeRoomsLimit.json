  "comment": {
    "text": "Warning toast in the agent form, shown when the user ticks one more knowledge base in the room selector than an agent can link; that room stays unticked. {{limit}} is the maximum number of knowledge bases (20). Use the same term as the Knowledge bases label in the form.",
    "is_auto": true,
    "updated_at": "2026-11-18T08:13:34.331Z",
    "model": "claude-opus-5-5"
  },
  "usage": [
    {
      "file_path": "/packages/client/src/pages/AiProjects/sub-components/dialogs/AgentRoomsSelector.tsx",
      "line_number": 112,
      "context": "// The limit is never shown up front: only ticking a room past it is told.\n const onRoomsLimitReached = () =>\n toastr.warning(\n isKnowledge\n ? t(\"Common:AIProjectKnowledgeRoomsLimit\", { limit: AI_PROJECT_MAX_ROOMS_PER_TYPE })\n : t(\"Common:AIProjectInstructionsRoomsLimit\", { limit: AI_PROJECT_MAX_ROOMS_PER_TYPE }),\n );\n \n // Why a room cannot be linked, or `null` when it can. The server links\n // only rooms the user may manage, and refuses the whole save over one that",
      "module": "/packages/client"
    }
  ],
