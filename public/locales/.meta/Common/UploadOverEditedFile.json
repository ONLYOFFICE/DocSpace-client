{
  "key_path": "UploadOverEditedFile",
  "content": "“{{fileName}}” is open for editing and can’t get a new version now, so the upload is saved as a separate copy. To update the file itself, upload it again after editing is finished.",
  "content_en_sha1_hash": "3306b9a380e0a8609d1254f43bf5e3cd0b74d4be",
  "created_at": "2026-11-24T09:20:14.506Z",
  "updated_at": "2026-11-24T09:21:03.404Z",
  "comment": {
    "text": "Warning toast after the user chooses Overwrite with version update for an uploaded file whose namesake is open in the editor; {{fileName}} is the file name (several names joined with commas). Explains that the upload is saved as a separate copy and how to update the file later.",
    "is_auto": true,
    "updated_at": "2026-11-24T09:21:03.404Z",
    "model": "claude-opus-5-5"
  },
  "usage": [
    {
      "file_path": "/packages/client/src/components/dialogs/ConflictResolveDialog/index.tsx",
      "line_number": 252,
      "context": "if (\n conflictResolveType === ConflictResolveType.Overwrite &&\n editingTitles?.length\n ) {\n toastr.warning(\n t(\"Common:UploadOverEditedFile\", {\n fileName: editingTitles.join(\", \"),\n }),\n );\n }",
      "module": "/packages/client"
    }
