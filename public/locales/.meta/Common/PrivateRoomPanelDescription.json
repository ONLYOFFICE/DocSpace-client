{
  "key_path": "PrivateRoomPanelDescription",
  "content": "A room for confidential files with end-to-end encryption: files are encrypted in your browser, and only room members can read them. A private room cannot be turned into a regular room.",
  "content_en_sha1_hash": "f3121617a1fdb8694c34c4e2c57e6a19ea3c8c55",
