  "comment": {
    "text": "Info toast in the file list of the client and of the SDK private page, and the message shown in place of the editor, when an encrypted file of a private room is opened while the connected Document Server cannot edit encrypted files; also the toast of the editor's file picker when an encrypted file is chosen to insert into a document. A full sentence; \"this editor\" means the Document Server the portal is connected to.",
    "is_auto": true,
    "updated_at": "2026-11-05T14:17:22.436Z",
    "model": "claude-fable-5-1"
  },
  "usage": [
    {
      "file_path": "/packages/client/src/store/filesStore/actions.helpers.ts",
      "line_number": 150,
      "context": "self.filesSettingsStore;\n const item = self.files.find((f) => f.id === id);\n \n // Spec: private-rooms/editor-integration, \"Document Server capability check before opening\"\n if (item?.encrypted && !isEncryptedEditingAvailable) {\n toastr.info(i18n.t(\"Common:PrivateRoomEditorNotSupported\"));\n return;\n }\n \n const share = shareKey || self.publicRoomStore.publicRoomKey;",
      "module": "/packages/client"
    },
    {
      "file_path": "/packages/doceditor/src/components/Editor.tsx",
      "line_number": 497,
      "context": "const EditorNotSupported = ({ config }: Pick<EditorProps, \"config\">) => {\n const { t } = useTranslation([\"Common\"]);\n return (\n <EditorMessage config={config}>\n {t(\"Common:PrivateRoomEditorNotSupported\")}\n </EditorMessage>\n );\n };\n \n // Spec: editor-integration, \"Document Server capability check before opening\"",
      "module": "/packages/doceditor"
    },
    {
      "file_path": "/packages/doceditor/src/hooks/useSelectFileDialog.ts",
      "line_number": 212,
      "context": "async (file: TSelectedFileInfo, isInsidePrivateRoom?: boolean) => {\n try {\n if (!file) return;\n \n if (isEncryptedPick(file, isInsidePrivateRoom)) {\n toastr.info(t(\"Common:PrivateRoomEditorNotSupported\"));\n return;\n }\n \n if (filesType === aiAttachFileAction) {\n settleAIFileRequest(file);",
      "module": "/packages/doceditor"
    },
    {
      "file_path": "/packages/sdk/src/app/(personal-files)/_components/docs-layout/index.tsx",
      "line_number": 514,
      "context": "portalFilesSettings?.storeOriginalFiles ?? false;\n \n const openFileHandler = React.useCallback(\n (file: TFileItem, preview?: boolean) => {\n if (refusesEncryptedOpen(isPrivate, file, portalFilesSettings)) {\n toastr.info(t(\"Common:PrivateRoomEditorNotSupported\"));\n return;\n }\n if (!preview && file.viewAccessibility?.MustConvert) {\n requestConvert(file);\n return;",
      "module": "/packages/sdk"
    }
