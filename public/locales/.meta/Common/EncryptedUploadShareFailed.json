      "line_number": 939,
      "context": "}\n \n // Spec: file-operations, \"Uploads into a private room are encrypted on the client\"\n if (result.shareFailed) {\n toastr.warning(\n i18n.t(\"Common:EncryptedUploadShareFailed\", {\n names: result.originalName,\n }),\n );\n }\n } finally {",
      "module": "/packages/client"
