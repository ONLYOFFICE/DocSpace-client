{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/pnpm-workspace.yaml"
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "source": [
      "default",
      "!{projectRoot}/__tests__/screenshots/**/*",
      "!{projectRoot}/**/*.md"
    ],
    "production": [
      "source",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/**/*.stories.@(js|jsx|ts|tsx|mdx)"
    ],
    "publicCode": [
      "{workspaceRoot}/public/locales/.constants/*.json",
      "{workspaceRoot}/public/locales/en/*.json",
      "{workspaceRoot}/public/scripts/config.json"
    ],
    "biomeConfig": [
      "{workspaceRoot}/packages/shared/biome.json",
      "{workspaceRoot}/packages/shared/biome-plugins/**/*"
    ]
  },
  "targetDefaults": {
    "build:translations": {
      "outputs": ["{projectRoot}/**/autoGeneratedTranslations.js"],
      "inputs": [
        "{projectRoot}/public/locales/**/*.json",
        "{workspaceRoot}/public/locales/**/*.json"
      ],
      "cache": true
    },
    "build": {
      "cache": true,
      "outputs": ["{projectRoot}/.next", "{projectRoot}/dist"]
    },
    "build:deploy": {
      "cache": true,
      "outputs": ["{projectRoot}/.next"]
    },
    "deploy": {
      "cache": false
    },
    "storybook-build": {
      "cache": true,
      "outputs": ["{projectRoot}/storybook-static"]
    },
    "test:build": {
      "cache": true,
      "outputs": ["{projectRoot}/.next", "{projectRoot}/dist"]
    },
    "test": {
      "cache": true,
      "inputs": [
        "source",
        "^production",
        "publicCode",
        "{workspaceRoot}/public/images/**/*"
      ]
    },
    "tsc": {
      "cache": true,
      "inputs": ["source", "^production", "publicCode"]
    },
    "lint": {
      "cache": true,
      "inputs": ["source", "biomeConfig"]
    }
  },
  "defaultBase": "develop",
  "parallel": 2,
  "tui": {
    "enabled": false
  },
  "analytics": false
}
