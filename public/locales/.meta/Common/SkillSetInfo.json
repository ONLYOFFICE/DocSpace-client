  "comment": {
    "text": "Item in the actions menu of a skill set in the AI Chat section; opens the info panel with its details and members. Noun phrase, not a verb. Short menu label, no full stop. Skill set = a room of skills, Markdown instructions the AI assistant follows; never call it a room. Match Common:CreateSkillSet.",
    "is_auto": true,
    "updated_at": "2026-11-21T13:04:52.624Z",
    "model": "claude-fable-5-2"
  },
  "usage": [
    {
      "file_path": "/packages/client/src/store/contextOptionsStore/filesContextOptions.helpers.ts",
      "line_number": 730,
      "context": "label: isAgent\n ? t(\"Common:AgentInfo\")\n : isKnowledgeBase\n ? t(\"Common:KnowledgeBaseInfo\")\n : isSkillSet\n ? t(\"Common:SkillSetInfo\")\n : t(\"Common:RoomInfo\"),\n icon: InfoOutlineReactSvgUrl,\n onClick: () => self.onShowInfoPanel(item),\n disabled: isPublicRoom || Boolean(item.external && item.isLinkExpired),\n },",
      "module": "/packages/client"
    }
