  "comment": {
    "text": "Error toast shown in a private (end-to-end encrypted) room when the server refuses a member's leave, removal or role change, which happens while that member has no encryption keys. A toast read in passing: keep it as short as the English, one clause for the outcome and one for the cause. The member is the person whose access was being changed, who is the user themself when they tried to leave the room.",
    "is_auto": true,
    "updated_at": "2026-11-11T07:15:49.072Z",
    "model": "claude-fable-5-2"
  },
