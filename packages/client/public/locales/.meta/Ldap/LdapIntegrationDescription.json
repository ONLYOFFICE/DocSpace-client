{
  "key_path": "LdapIntegrationDescription",
  "content": "Import users and groups via LDAP, and let users sign in with their LDAP credentials. Users are imported as soon as you save these settings — anyone added later is imported the first time they sign in. To allow LDAP sign-in only, turn off inviting new members via {{sectionName}}: <1>{{link}}</1>",
  "content_en_sha1_hash": "938c8039c8a4edb769e4083670caa4febb714ea4",
  "created_at": "2026-08-31T18:23:43.762Z",
  "updated_at": "2026-08-31T20:02:18.383Z",
  "comment": {
    "text": "Introductory text on the LDAP integration settings page explaining user/group import and sign-in behavior. It includes a variable `sectionName` for a section title and a `<1>` tag containing a clickable link.",
    "is_auto": true,
    "updated_at": "2026-08-31T20:02:18.383Z",
    "model": "gemma4:26b"
  },
