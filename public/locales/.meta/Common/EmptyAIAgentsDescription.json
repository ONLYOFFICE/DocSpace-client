  "comment": {
    "text": "This is the description text displayed in an empty state for the AI Agents section. It appears when no AI agents have been set up and the user does not have AI features enabled. `{{mcpServer}}` refers to the name of the MCP server.",
    "is_auto": true,
    "updated_at": "2026-04-11T21:07:08.281Z",
    "model": "google/gemini-2.5-flash"
  },
