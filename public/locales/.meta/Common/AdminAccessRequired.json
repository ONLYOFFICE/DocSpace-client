  "usage": [
    {
      "file_path": "/packages/client/src/pages/Dashboard/sub-components/DevToolsCard.tsx",
      "line_number": 279,
      "context": "// Says why a tile leads nowhere, in place of the 403 that following it used\n // to produce. Shared by every tile, so the wording is stated once.\n const showAdminOnlyToast = () => {\n toastr.warning(\n t(\"Common:AdminOnlyFeature\"),\n t(\"Common:AdminAccessRequired\"),\n );\n };\n \n // The dashboard tour reads its anchors from the DOM, so the dev-tools step\n // drops itself once this returns nothing - no tour change needed here.",
      "module": "/packages/client"
    },
    {
      "file_path": "/packages/client/src/pages/PortalSettings/categories/developer-tools/DocsConnect/PromoPage.tsx",
      "line_number": 103,
      "context": "<div\n className={styles.accessNotice}\n data-testid=\"docs_connect_access_notice\"\n >\n <Text as=\"p\" className={styles.accessNoticeTitle}>\n {t(\"Common:AdminAccessRequired\")}\n </Text>\n <Text as=\"p\" className={styles.description}>\n {t(\"DocsConnect:AdminAccessDescription\", {\n service: t(\"DocsConnect:DocsConnect\"),\n })}",
      "module": "/packages/client"
    }
