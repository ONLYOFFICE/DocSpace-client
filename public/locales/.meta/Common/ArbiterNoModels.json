  "comment": {
    "text": "Message shown in the AI Arbiter setup wizard when the workspace has no AI model configured yet. It is a missing precondition rather than a failure, so the wizard keeps its own header and offers Retry. Replaces the former ArbiterNoAIProvider, which said \"provider\" after the panel moved to AI profiles.",
    "is_auto": false,
    "updated_at": "2026-09-04T00:00:00.000Z",
    "model": null
  },
  "usage": [
    {
      "file_path": "/packages/sdk/src/app/(ai-arbiter)/_components/wizard/WizardOverlay.tsx",
      "line_number": 229,
      "context": "const modelRef =\n models.find((m) => m.profileId === preferredId) ?? models[0];\n if (!modelRef) {\n // A workspace with no AI model configured is a missing precondition,\n // not a failed setup: it keeps the wizard's own header and still\n // offers Retry, which re-runs the bootstrap once a model is added.\n setErrorMessage(t(\"Common:ArbiterNoModels\"));\n setPhase(\"no-models\");\n return;\n }\n \n const wizard = await ensureWizardAgent({\n userId,",
      "module": "/packages/sdk"
    }
  ],
