{
  "key_path": "CollectResultsInXlsxDescription",
  "content": "Form responses are automatically saved to spreadsheets. Spreadsheets are created in the same folder where filled form copies are stored. A separate XLSX file is generated for each form. Each row represents a single filled form, and columns correspond to form fields.",
  "content_en_sha1_hash": "bc663adcefeee4d03fc5f774ce8fb1e27b8b57ff",
