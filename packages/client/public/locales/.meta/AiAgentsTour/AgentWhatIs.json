{
  "key_path": "AgentWhatIs",
  "content": "Unlike an ordinary chat, an AI agent stays in your list, and you can come back to it at any time. Each agent has its own conversation history, settings and a knowledge base built from the documents you add.",
  "content_en_sha1_hash": "37cdce95c398275a13f1469b3622c7d2c96a9933",
  "created_at": "2026-10-12T12:32:40.059Z",
